# Default owners for everything in the repo.
*                                       @cipherstash/developers

# Supply-chain critical paths — changes here require explicit review
# (lirantal/npm-security-best-practices; see skills/stash-supply-chain-security/).
/.github/workflows/                     @cipherstash/developers
# Composite actions are workflow code by another name: they run arbitrary steps
# in the same job, with the same secrets, so they need the same review gate.
/.github/actions/                       @cipherstash/developers
/.github/dependabot.yml                 @cipherstash/developers
/.github/CODEOWNERS                     @cipherstash/developers
/pnpm-workspace.yaml                    @cipherstash/developers
/pnpm-lock.yaml                         @cipherstash/developers
/.npmrc                                 @cipherstash/developers
/skills/stash-supply-chain-security/    @cipherstash/developers

# The stack-* crates, their node bindings and the Go module, imported from
# cipherstash-suite. stack-auth, stack-profile and @cipherstash/auth publish to
# crates.io and npm.
/packages/stack-*/                      @cipherstash/developers
/languages/golang/                      @cipherstash/developers
/languages/typescript/packages/auth/    @cipherstash/developers
/languages/typescript/packages/profile/ @cipherstash/developers
/languages/typescript/packages/stack-auth-wasm/ @cipherstash/developers
