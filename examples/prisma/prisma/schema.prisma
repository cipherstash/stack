// @cipherstash/prisma-next example schema — EQL v3.
//
// One User model exercising one v3 domain per plaintext family. Each
// v3 constructor is argument-less and maps 1:1 to a concrete
// `public.eql_v3_*` Postgres domain; the constructor IS the capability
// set (there are no per-column search-mode flags in v3).
//
// Operator visibility per column follows from the domain's query
// capabilities (see the package README's operator surface table):
//
//   - email         (EncryptedTextSearch → eql_v3_text_search)
//                     equality + order/range + free-text search:
//                     eqlEq / Neq / In / NotIn /
//                     Gt / Gte / Lt / Lte / Between / NotBetween /
//                     Match, eqlAsc / Desc.
//   - salary        (EncryptedDoubleOrd → eql_v3_double_ord)
//                     equality + order/range.
//   - accountId     (EncryptedBigIntOrd → eql_v3_bigint_ord)
//                     equality + order/range.
//   - birthday      (EncryptedDateOrd → eql_v3_date_ord)
//                     equality + order/range.
//   - emailVerified (EncryptedBoolean → eql_v3_boolean)
//                     STORAGE-ONLY: no search operators at all — every
//                     eql* predicate throws
//                     EncryptionOperatorError on this column.
//   - preferences   (EncryptedJson → eql_v3_json)
//                     searchable JSON: eqlJsonContains
//                     (encrypted jsonb `@>` containment).
//
// v3 emits NO search configs: the domain carries its own index
// metadata, so there are no `eql_v2.add_search_config` /
// `add_encrypted_constraint` migration ops (and none of that bundle's
// quoted-identifier quirks). The `@@map("users")` / lowercase column
// maps below are kept anyway: `user` is a reserved word in Postgres,
// and stable physical names keep the example's SQL and docs boring.

model User {
  id            String @id
  email         cipherstash.EncryptedTextSearch()
  salary        cipherstash.EncryptedDoubleOrd()
  accountId     cipherstash.EncryptedBigIntOrd()  @map("accountid")
  birthday      cipherstash.EncryptedDateOrd()
  emailVerified cipherstash.EncryptedBoolean()    @map("emailverified")
  preferences   cipherstash.EncryptedJson()

  @@map("users")
}
