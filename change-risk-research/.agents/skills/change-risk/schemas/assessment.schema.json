{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cipherstash/stack/change-risk-research/.agents/skills/change-risk/schemas/assessment.schema.json",
  "title": "Change-risk assessment",
  "description": "Machine-readable output of the change-risk skill. Advisory only. Impact describes what could happen if a scenario occurred, not how likely it is.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "base_sha",
    "head_sha",
    "assessor",
    "inputs",
    "summary",
    "behaviour_changes",
    "impact",
    "verification_confidence",
    "release_readiness",
    "affected_components",
    "failure_scenarios",
    "verification_gaps",
    "recommended_controls",
    "coverage_limitations",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_sha": { "$ref": "#/$defs/sha" },
    "head_sha": { "$ref": "#/$defs/sha" },
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "model", "skill_version"],
      "properties": {
        "agent": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "skill_version": { "type": "string", "minLength": 1 },
        "condition": { "type": "string" },
        "generated_at": { "type": "string" }
      }
    },
    "inputs": {
      "description": "Every input the method can use, each explicitly available, partial or unavailable.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diff",
        "source_checkout",
        "pr_description",
        "ci_results",
        "architecture_docs",
        "dependency_graph",
        "codeowners",
        "history_signals",
        "deployment_context"
      ],
      "properties": {
        "diff": { "$ref": "#/$defs/input" },
        "source_checkout": { "$ref": "#/$defs/input" },
        "pr_description": { "$ref": "#/$defs/input" },
        "ci_results": { "$ref": "#/$defs/input" },
        "architecture_docs": { "$ref": "#/$defs/input" },
        "dependency_graph": { "$ref": "#/$defs/input" },
        "codeowners": { "$ref": "#/$defs/input" },
        "history_signals": { "$ref": "#/$defs/input" },
        "deployment_context": { "$ref": "#/$defs/input" }
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "behaviour_changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/behaviour_change" }
    },
    "impact": { "$ref": "#/$defs/impact" },
    "verification_confidence": {
      "enum": ["high", "medium", "low", "unknown"]
    },
    "release_readiness": {
      "enum": [
        "ready_for_review",
        "focused_review_required",
        "changes_or_verification_required",
        "insufficient_evidence"
      ]
    },
    "affected_components": {
      "type": "array",
      "items": { "$ref": "#/$defs/affected_component" }
    },
    "failure_scenarios": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/failure_scenario" }
    },
    "verification_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/verification_gap" }
    },
    "recommended_controls": {
      "type": "array",
      "items": { "$ref": "#/$defs/recommended_control" }
    },
    "coverage_limitations": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverage_limitation" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "impact": { "enum": ["low", "medium", "high", "critical", "unknown"] },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^E-[0-9]+$" }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["available", "partial", "unavailable"] },
        "source": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "behaviour_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "certainty", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^BC-[0-9]+$" },
        "kind": {
          "enum": [
            "public_contract",
            "invariant",
            "state_or_persistence",
            "external_side_effect",
            "error_handling",
            "concurrency_or_ordering",
            "security_boundary",
            "build_or_release",
            "dependency",
            "configuration",
            "documentation",
            "test_only",
            "other"
          ]
        },
        "description": { "type": "string", "minLength": 1 },
        "certainty": { "enum": ["observed", "inferred", "unknown"] },
        "evidence": { "$ref": "#/$defs/evidence_ids" }
      }
    },
    "affected_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "relationship", "how", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "package",
            "module",
            "public_api",
            "service",
            "database",
            "ci_or_release",
            "published_artifact",
            "external_consumer",
            "documentation",
            "other"
          ]
        },
        "relationship": {
          "description": "confirmed: a reference was read in the code or config. likely: indirect evidence. hypothetical: plausible but no evidence found.",
          "enum": ["changed", "confirmed", "likely", "hypothetical"]
        },
        "how": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence_ids" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "status", "evidence"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "status": {
          "description": "ran_passed and ran_failed require CI or command output evidence. A test that exists is exists_not_run unless its result was seen.",
          "enum": ["ran_passed", "ran_failed", "exists_not_run", "unknown"]
        },
        "evidence": { "$ref": "#/$defs/evidence_ids" }
      }
    },
    "failure_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "trigger",
        "affected_components",
        "mechanism",
        "consequence",
        "impact",
        "basis",
        "evidence",
        "existing_verification",
        "missing_verification",
        "mitigation"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^FS-[0-9]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "trigger": { "type": "string", "minLength": 1 },
        "affected_components": {
          "type": "array",
          "items": { "type": "string", "pattern": "^AC-[0-9]+$" }
        },
        "mechanism": { "type": "string", "minLength": 1 },
        "consequence": { "type": "string", "minLength": 1 },
        "impact": { "$ref": "#/$defs/impact" },
        "basis": {
          "description": "observed_defect: the code as changed demonstrably does the wrong thing (cite it). plausible_failure: the mechanism is supported by evidence but depends on a trigger not shown to occur. speculative: worth a look, weak support.",
          "enum": ["observed_defect", "plausible_failure", "speculative"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^E-[0-9]+$" }
        },
        "existing_verification": {
          "type": "array",
          "items": { "$ref": "#/$defs/verification" }
        },
        "missing_verification": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "mitigation": { "type": "string", "minLength": 1 },
        "domain_tags": {
          "type": "array",
          "items": {
            "enum": [
              "encryption",
              "key_management",
              "plaintext_exposure",
              "authorization",
              "tenant_isolation",
              "serialization_compatibility",
              "public_api",
              "persistence_migration",
              "concurrency",
              "distributed_state",
              "retry_idempotency",
              "event_processing",
              "dependency",
              "build_release",
              "configuration",
              "other"
            ]
          }
        }
      }
    },
    "verification_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "scenarios", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^VG-[0-9]+$" },
        "description": { "type": "string", "minLength": 1 },
        "scenarios": {
          "type": "array",
          "items": { "type": "string", "pattern": "^FS-[0-9]+$" }
        },
        "evidence": { "$ref": "#/$defs/evidence_ids" }
      }
    },
    "recommended_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "addresses"],
      "properties": {
        "id": { "type": "string", "pattern": "^RC-[0-9]+$" },
        "kind": {
          "enum": [
            "test",
            "review_focus",
            "compatibility_check",
            "staged_rollout",
            "feature_flag",
            "monitoring",
            "rollback_plan",
            "documentation",
            "other"
          ]
        },
        "description": { "type": "string", "minLength": 1 },
        "addresses": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(FS|VG)-[0-9]+$" }
        }
      }
    },
    "coverage_limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "effect"],
      "properties": {
        "id": { "type": "string", "pattern": "^CL-[0-9]+$" },
        "description": { "type": "string", "minLength": 1 },
        "effect": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "claim", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^E-[0-9]+$" },
        "kind": {
          "enum": [
            "code",
            "diff",
            "history_signal",
            "test",
            "ci_result",
            "command_output",
            "documentation",
            "pr_description"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "rev": {
          "description": "Which revision the path and lines refer to. Defaults to head.",
          "enum": ["base", "head"]
        },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "signal": {
          "description": "For history_signal: the collector field, e.g. co_change.omitted_co_changes[0].",
          "type": "string"
        },
        "command": { "type": "string" },
        "claim": { "type": "string", "minLength": 1 },
        "status": {
          "description": "verified: the assessor read the cited source and it shows the claim. inferred: the claim is the assessor's reading and was not directly confirmed.",
          "enum": ["verified", "inferred"]
        }
      }
    }
  }
}
