      "id": "symbol-for-word",
      "clause": "1: 5.3.2 d)",
      "severity": "advise",
      "say": "A symbol standing for a word. Write the word: \"about\", \"and\", \"times\", \"or\".",
      "flags": "",
      "patterns": [
        "\\s&\\s",
        "\\b\\d+x (?:faster|slower|more|less|bigger|smaller|larger)\\b",
