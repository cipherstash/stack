{
  "version": 1,
  "profile": "record-query-refusals-v1",
  "required_capabilities": ["records", "query-errors", "term-errors"],
  "fields": {
    "email": {
      "kind": "string",
      "outputs": ["c", "eq"]
    },
    "name": {
      "kind": "string",
      "outputs": ["c", "match"]
    },
    "nickname": {
      "kind": "string",
      "outputs": ["c", "ore"]
    },
    "title": {
      "kind": "string",
      "outputs": ["c", "ore_block"]
    },
    "age": {
      "kind": "uint32",
      "outputs": ["c", "eq", "ore"]
    },
    "score": {
      "kind": "float64",
      "outputs": ["c", "ore"]
    },
    "big": {
      "kind": "int128",
      "outputs": ["c", "eq", "ope"]
    },
    "flag": {
      "kind": "bool",
      "outputs": ["c"]
    },
    "note": {
      "kind": "string",
      "outputs": ["c"]
    },
    "sealed_age": {
      "kind": "int64",
      "outputs": ["c", "eq"],
      "null": "sealed"
    },
    "sql_age": {
      "kind": "int64",
      "outputs": ["c", "eq"],
      "null": "sql"
    },
    "data": {
      "kind": "bytes",
      "outputs": ["c", "eq", "ore"]
    }
  },
  "cases": [
    {
      "id": "eq-on-match-only",
      "field": "name",
      "operator": "eq",
      "input": {
        "type": "string",
        "text": "alice"
      },
      "accepted": false,
      "expected_error": {
        "class": "source",
        "code": "stack_encrypt::dynamic_source",
        "reason": "operator_not_answered",
        "field": "name"
      }
    },
    {
      "id": "matches-on-equality-only",
      "field": "email",
      "operator": "matches",
      "input": {
        "type": "string",
        "text": "ali"
      },
      "accepted": false,
      "expected_error": {
        "class": "source",
        "code": "stack_encrypt::dynamic_source",
        "reason": "operator_not_answered",
        "field": "email"
      }
    },
