        },
        {
          "pattern": "\\bobtain(?:s|ed|ing)?\\b",
          "instead": "\"get\""
        },
        {
          "pattern": "\\bregarding\\b",
          "instead": "\"about\""
        },
        {
          "pattern": "\\b(?:is|are) able to\\b",
          "instead": "\"can\""
        },
        {
          "pattern": "\\bin terms of\\b",
          "instead": "a direct phrase: \"in\", \"for\", \"about\""
        },
        {
          "pattern": "\\bthe fact that\\b",
          "instead": "\"that\", or rewrite the sentence"
        },
        {
          "pattern": "\\bwhether or not\\b",
          "instead": "\"whether\", unless \"or not\" changes the meaning"
        },
        {
          "pattern": "\\bas (?:previously |already )?(?:mentioned|noted|discussed|stated)(?: (?:above|earlier|before))?\\b",
          "instead": "nothing: state the point, or link to it"
        },
        {
          "pattern": "\\bthere (?:is|was) a need (?:to|for)\\b",
          "instead": "\"you need to\" or \"we need to\""
        },
