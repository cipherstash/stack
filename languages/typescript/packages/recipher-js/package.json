{
  "name": "@cipherstash/recipher",
  "version": "0.0.0",
  "private": true,
  "description": "Encrypt values with per-value ZeroKMS data keys, through the Stack Encrypt engine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cipherstash/stack.git",
    "directory": "languages/typescript/packages/recipher-js"
  },
  "license": "MIT",
  "author": "CipherStash <humans@cipherstash.com>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "build:native": "napi build --manifest-path crate/Cargo.toml --output-dir . --release --dts native.d.ts --no-const-enum",
    "build:debug": "napi build --manifest-path crate/Cargo.toml --output-dir . --features testing --dts native.d.ts --no-const-enum",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && pnpm run typecheck",
    "test:addon": "tsup && vitest run --config vitest.addon.config.ts",
    "test:cargo": "cargo test --locked --all-features && cargo fmt --all --check && cargo clippy --locked --all-targets --all-features -- -D warnings"
  },
  "napi": {
    "binaryName": "recipher",
    "dtsHeader": "/* The addon's TypeScript declarations, generated by napi-rs from `crate/`.\n   `build:debug` writes this file; do not edit it. CI fails when it is stale. */\n\n/** What a native call returns, or resolves to: never a thrown error. */\nexport type Outcome<T> =\n  | { ok: true; value: T }\n  | { ok: false; error: RecipherErrorFields }\n\n"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12",
    "@types/node": "catalog:repo",
    "tsup": "catalog:repo",
    "typescript": "catalog:repo",
    "vitest": "catalog:repo"
  },
  "engines": {
    "node": ">=22"
  }
}
