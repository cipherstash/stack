      "severity": "block",
      "say": "An arrow stands in for a verb, and the reader has to guess which one. Write the verb: \"becomes\", \"leads to\", \"calls\", \"then\".",
      "flags": "",
      "patterns": [
        "(?:^|\\s)(?:→|⇒|⟶|⟹|->|=>|←|<-)(?:\\s|$)"
      ]
    },
    {
      "id": "condition-after-instruction",
      "clause": "1: 5.2.2 b), 5.3.3 a) 4)",
      "severity": "block",
      "say": "The condition comes after the instruction, so the reader acts before they know whether it applies. Put the condition first: \"If you need it, tell me where to keep it.\"",
      "flags": "",
      "patterns": [
        "^(?:Tell|Ask|Run|Use|Check|Add|Remove|Write|Send|Set|Open|Read|Delete|Install|Make|Keep|Put|Give|Let|Move|Change|Update|Stop|Start|Try|Call|Create|Choose|Pick|Select|Restart|Reply|Contact|Email|See|Look|Review|Approve|Merge|Push|Commit|Edit|Fix|Turn|Switch|Enable|Disable)\\b(?!\\s+(?:if|whether)\\b)[^.!?]{12,}?(?<!\\bonly|\\beven)\\s(?:if|when|unless|once)\\s+(?:you|your)\\b[^.!?]*[.!?]?$"
      ],
      "scope": "sentence"
    },
    {
      "id": "stacked-hedge",
      "clause": "3: 5.3.3 f)",
      "severity": "block",
      "say": "Two hedges on one claim. Keep one, and tie it to the evidence: what you saw, how often, how many.",
      "patterns": [
        "\\b(?:might|may|could|would|can) (?:possibly|potentially|perhaps|conceivably)\\b",
        "\\b(?:possibly|perhaps|maybe) (?:might|may|could)\\b",
        "\\b(?:seems?|appears?) to (?:suggest|indicate|imply)\\b"
      ]
    },
    {
      "id": "negative-contraction",
      "clause": "house style (GOV.UK), 1: 5.3.3 d)",
      "severity": "block",
      "say": "Readers can misread a negative contraction as its opposite. Write the negative in full: \"cannot\", \"does not\", \"is not\".",
      "patterns": [
        "\\b\\w+n['’]t\\b"
      ]
    },
    {
      "id": "date-format",
      "clause": "house style, 1: 5.3.3 e)",
      "severity": "block",
      "say": "Write dates as day, month, year with no ordinal and no comma: \"1 July 2026\".",
      "patterns": [
        "\\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+\\d{1,2}(?:st|nd|rd|th)?,?\\s+\\d{4}\\b",
        "\\b\\d{1,2}(?:st|nd|rd|th)\\s+(?:of\\s+)?(?:January|February|March|April|May|June|July|August|September|October|November|December)\\b"
      ]
    },
    {
      "id": "inclusive-language",
      "clause": "1: 5.3.7",
      "severity": "block",
      "say": "Use inclusive terms: \"allowlist\" and \"blocklist\", \"primary\" and \"replica\", \"placeholder\", \"check\".",
      "patterns": [
        "\\b(?:white|black)[- ]?list(?:s|ed|ing)?\\b",
        "\\bmaster/slave\\b|\\bslaves?\\b",
        "\\bdummy (?:value|data|variable|text)\\b"
      ]
    },
    {
