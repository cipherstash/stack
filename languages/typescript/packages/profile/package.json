{
  "name": "@cipherstash/profile",
  "version": "0.35.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "stack-profile-node",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "stack-profile-node.js"
  ],
  "scripts": {
    "build:native": "napi build --release --dts native.d.ts",
    "build:debug": "napi build --dts native.d.ts",
    "test": "vitest run && biome check .",
    "test:cargo": "cargo test --locked"
  },
  "optionalDependencies": {
    "@cipherstash/profile-darwin-x64": "workspace:*",
    "@cipherstash/profile-darwin-arm64": "workspace:*",
    "@cipherstash/profile-linux-x64-gnu": "workspace:*",
    "@cipherstash/profile-linux-arm64-gnu": "workspace:*",
    "@cipherstash/profile-linux-x64-musl": "workspace:*",
    "@cipherstash/profile-win32-x64-msvc": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2",
    "vitest": "catalog:repo",
    "typescript": "^5"
  }
}
