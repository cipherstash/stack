{
  "version": 1,
  "profile": "record-runtime-v1",
  "required_capabilities": [
    "records",
    "equality",
    "null-policies",
    "lossless-query-conversion"
  ],
  "cases": [
    {
      "id": "required-missing",
      "operation": "seal",
      "kind": "int32",
      "null": "",
      "rows": [{}],
      "expected_error": {
        "code": "stack_encrypt::dynamic_source",
        "reason": "field_missing",
        "field": "value",
        "go_message": "cipherstash: malformed input: row 0: no value for field \"value\""
      }
    },
    {
      "id": "required-null",
      "operation": "seal",
      "kind": "int32",
      "null": "",
      "rows": [
        {
          "value": {
            "type": "null",
            "text": ""
          }
        }
      ],
      "expected_error": {
        "code": "stack_encrypt::dynamic_source",
        "reason": "field_type",
        "field": "value"
      }
    },
    {
      "id": "required-boundaries",
      "operation": "seal",
      "kind": "int32",
      "null": "",
      "rows": [
        {
          "value": {
