    {
      "id": "plainer-word",
      "clause": "1: 5.3.2",
      "severity": "advise",
      "say": "A more familiar word exists: {instead}.",
      "items": [
        {
          "pattern": "\\badditionally\\b",
          "instead": "\"also\""
        },
        {
          "pattern": "\\bapproximately\\b",
          "instead": "\"about\""
