    {
      "id": "vague-modifier",
      "clause": "1: 5.3.4 b), 5.3.7",
      "severity": "advise",
      "say": "Adds little meaning. Delete it, or replace it with a number or a fact. \"Obviously\", \"simply\" and \"just\" can also read as talking down to the reader.",
      "patterns": [
        "\\b(?:very|really|quite|extremely|incredibly|basically|essentially|actually|simply|obviously|honestly|genuinely|definitely|totally|just)\\b",
