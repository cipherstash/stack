  "paths": {
    "/create-client": {
      "post": {
        "tags": [
          "Clients"
        ],
        "operationId": "create_client",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateClientRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Client created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateClientResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid token"
          },
          "403": {
            "description": "Forbidden - insufficient permissions"
          }
        },
        "security": [
          {
            "cts_access_token": []
          }
        ]
      }
    },
    "/create-keyset": {
      "post": {
        "tags": [
          "Keysets"
        ],
        "summary": "Non-generic production entry point for `create`, enabling `routes!()` and\n`#[utoipa::path]` which don't support turbofish on generic functions.",
        "operationId": "create_keyset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateKeysetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Keyset created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateKeysetResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - validation failed"
          },
          "401": {
            "description": "Unauthorized - missing or invalid token"
          },
          "403": {
            "description": "Forbidden - insufficient permissions"
          },
          "409": {
            "description": "Conflict - duplicate keyset or client"
          }
        },
        "security": [
          {
            "cts_access_token": []
          }
        ]
      }
    },
