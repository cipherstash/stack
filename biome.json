{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/package.json",
      "!**/.turbo/",
      "!**/dist",
      "!**/nix/store"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "formatWithErrors": true
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noThenProperty": "off"
      }
    }
  },
  "plugins": ["./biome-plugins/no-type-erasing-assertions.grit"],
  "overrides": [
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test-d.ts",
        "**/integration/**",
        "**/tests/**",
        "**/*.spec.ts"
      ],
      "plugins": []
    }
  ]
}
