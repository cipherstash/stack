{
  "name": "@cipherstash/prisma-example",
  "private": true,
  "version": "0.1.0",
  "description": "End-to-end example of @cipherstash/stack-prisma: searchable application-layer encryption for Postgres with Prisma Next, using @cipherstash/stack as the SDK.",
  "type": "module",
  "scripts": {
    "emit": "prisma-next contract emit",
    "migration:plan": "prisma-next migration plan",
    "migration:apply": "prisma-next migrate --yes",
    "start": "tsx src/index.ts",
    "test:e2e": "vitest run --config test/e2e/vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cipherstash/stack-prisma": "workspace:*",
    "@cipherstash/stack": "workspace:*",
    "@prisma/orm-postgres": "0.17.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "pathe": "^2.0.3",
    "tsx": "catalog:repo",
    "typescript": "catalog:repo",
    "vitest": "catalog:repo"
  }
}
