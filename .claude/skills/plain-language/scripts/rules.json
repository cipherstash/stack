    {
      "id": "latin-abbreviation",
      "clause": "GOV.UK A to Z: eg, etc and ie; 1: 5.3.2 d)",
      "severity": "block",
      "say": "GOV.UK avoids these. Write \"for example\", \"such as\" or \"including\" for e.g.; rewrite or write \"that is\" for i.e.; and do not end a list with etc.",
      "patterns": [
        "(?<![\\w.])(?:e\\.g\\.|i\\.e\\.|etc\\.?|viz\\.|cf\\.|n\\.b\\.)(?![\\w])",
        "(?<![\\w.])(?:eg|ie)(?![\\w.])"
