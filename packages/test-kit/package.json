{
	"name": "@cipherstash/test-kit",
	"version": "0.0.1-rc.0",
	"private": true,
	"description": "Shared EQL v3 test harness: the domain catalog, the plaintext oracle, and the integration-suite driver. Consumed as TypeScript source — no build step.",
	"type": "module",
	"exports": {
		"./integration-clerk": "./src/integration/clerk.ts",
		".": "./src/index.ts",
		"./catalog": "./src/catalog.ts",
		"./suite": "./src/run-family-suite.ts"
	},
	"scripts": {
		"test:types": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@cipherstash/stack": "workspace:*"
	},
	"devDependencies": {
		"@clerk/backend": "3.11.0",
		"typescript": "catalog:repo",
		"vitest": "catalog:repo"
	}
}
