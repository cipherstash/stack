RETURNS boolean
LANGUAGE sql IMMUTABLE PARALLEL SAFE
AS $$ SELECT {{ schema }}.{{ b.extractor }}(a) >= {{ internal_schema }}.lo(r) AND {{ schema }}.{{ b.extractor }}(a) <= {{ internal_schema }}.hi(r) $$;
