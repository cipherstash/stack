# Copy to .env.local before running `supabase functions serve`.
# Get these from your CipherStash workspace dashboard.

CS_CLIENT_ACCESS_KEY=
CS_CLIENT_ID=
CS_CLIENT_KEY=

# Workspace CRN, format `crn:<region>:<workspace-id>`. The WASM client
# derives the region from this and asserts the access-key token's
# workspace against it.
CS_WORKSPACE_CRN=
